# Configurar estas variáveis em Vercel > Settings > Environment Variables.
# Supabase > Project Settings > Database > Connection string (URI), preferindo pooler se indicado.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Gere um segredo aleatório longo (mínimo 32 caracteres). Não reutilize palavras-passe.
SESSION_SECRET=SUBSTITUIR_POR_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES
ADMIN_EMAIL=admin@seudominio.ao
ADMIN_PASSWORD=SUBSTITUIR_POR_PALAVRA_PASSE_FORTE_DE_12_OU_MAIS_CARACTERES
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUIR_PELA_CHAVE_SERVICE_ROLE_SECRETA
SUPABASE_STORAGE_BUCKET=ulandu-media
